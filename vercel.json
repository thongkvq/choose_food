{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/nearby.js": { "maxDuration": 20 },
    "api/whereami.js": { "maxDuration": 15 },
    "api/weather.js": { "maxDuration": 15 },
    "api/geocode.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/data/dishes.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }]
    }
  ]
}
